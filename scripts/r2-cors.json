{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://isaacrozsa.com",
          "https://www.isaacrozsa.com",
          "https://*.vercel.app",
          "http://localhost:3001"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["Range"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "Accept-Ranges"],
      "maxAgeSeconds": 3600
    }
  ]
}
